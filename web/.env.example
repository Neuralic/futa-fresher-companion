# Copy to .env.local
# Leave VITE_API_URL empty to use the dev proxy (/api -> localhost:8000)
VITE_API_URL=
# true = serve fixtures from src/mocks (build the UI without waiting for the backend)
VITE_USE_MOCKS=true
# Mock mode only: rows per /sync page. Leave empty for one page. Set e.g. 2 to test paging.
VITE_MOCK_SYNC_PAGE_SIZE=
